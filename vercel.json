{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- frontend backend api requirements.txt vercel.json Dockerfile",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{backend/tests/**,**/__pycache__/**,docs/**,*.json,*.md}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
