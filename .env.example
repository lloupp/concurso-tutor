# Copie para .env e ajuste
DB_PATH=./data/concurso.db
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_API_KEY=
APP_ENV=development
# Use somente em desenvolvimento; produção deve aplicar migrations.
AUTO_CREATE_SCHEMA=true
PORT=8000

# Origens permitidas por CORS, separadas por vírgula (ex.: http://localhost:8000,https://meuapp.com).
# "*" libera qualquer origem (ok para dev/protótipo; restrinja em produção).
CORS_ORIGINS=*
